# BASS optional environment variables
#
# Python and PowerShell launchers do not load this file automatically. Export
# only the values you need in the shell, service, CI job, or Gradle process that
# starts BASS. Do not commit real passwords, private keys, device identities, or
# machine-specific paths.
#
# Linux/macOS example: export NAME=value
# PowerShell example:  $env:NAME = "value"

# Host runtime
# BASS_RUNTIME_MODE=<pc-or-pi>
# BASS_HOST=<must-be-127.0.0.1>
# BASS_PORT=5056
# BASS_DASHBOARD_PORT=5057
# FACEID_DB_PATH=<absolute-path-to-faceid.db>

# Persistent device identity and TLS
# BASS_DEVICE_CONFIG=<absolute-path-to-device.json>
# BASS_STATE_DIR=<absolute-directory-for-default-device-config>
# BASS_DEVICE_NAME=<name-used-when-device-config-is-first-created>
# BASS_OPENSSL=<path-or-command-for-openssl>

# Raspberry Pi camera and ESP32 runtime
# ESP32_SERIAL_PORT=<serial-device-path>
# ESP32_TRIGGER_ENABLED=<1-to-enable-or-0-to-disable>
# PI_SCAN_TIMEOUT_SECONDS=20
# PI_ENROLL_TIMEOUT_SECONDS=180
# PI_ENROLL_SAMPLE_INTERVAL_SECONDS=0.5
# PI_CAMERA_CLOSE_TIMEOUT_SECONDS=2.0

# Standalone hardware-free Device API fixture
# PORT=5055

# Raspberry Pi installer only
# FACEID_SERVICE_USER=<non-root-local-user>
# FACEID_DB_DIR=<absolute-directory-for-database-and-device-state>
# BASS_DEVICE_CONFIG_SOURCE=<absolute-path-to-transferred-device.json>

# Android release signing. Set all four together or leave all four unset.
# Debug builds do not require these values.
# BASS_ANDROID_KEYSTORE=<absolute-path-to-keystore>
# BASS_ANDROID_STORE_PASSWORD=<keystore-password>
# BASS_ANDROID_KEY_ALIAS=<key-alias>
# BASS_ANDROID_KEY_PASSWORD=<key-password>
