[Unit]
Description=FaceID Device API (Flask)
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/faceid/group-project-team-face-id-main
Environment=FACEID_DB_PATH=/home/pi/faceid/faceid.db
Environment=PORT=5000
ExecStartPre=/usr/bin/python3 /home/pi/faceid/group-project-team-face-id-main/db.py
ExecStart=/usr/bin/python3 /home/pi/faceid/group-project-team-face-id-main/pi_device_api.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
